
from langchain_core.embeddings import Embeddings
from langchain_ollama import OllamaEmbeddings

class NomicRAGEmbeddings(Embeddings):
    def __init__(self, base_url="http://localhost:11434", model="nomic-embed-text:v1.5"):
        self._base = OllamaEmbeddings(model=model, base_url=base_url)

    def embed_documents(self, texts):
        # REQUIRED by nomic v1.5 retrieval usage
        prefixed = [f"search_document: {t}" for t in texts]
        return self._base.embed_documents(prefixed)

    def embed_query(self, text):
        # REQUIRED by nomic v1.5 retrieval usage
        return self._base.embed_query(f"search_query: {text}")

embeddings = NomicRAGEmbeddings()
